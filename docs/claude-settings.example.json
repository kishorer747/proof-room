{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "permissions": {
    "blockReadsOutsideWorkingDirectories": true,
    "deny": [
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Workflow",
      "Skill",
      "RemoteTrigger",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "PushNotification",
      "SendMessage",
      "ListAgents",
      "TaskStop",
      "DesignSync",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit",
      "ReportFindings"
    ],
    "allow": [
      "mcp__page_fetch",
      "mcp__site_publish"
    ]
  },
  "enableAllProjectMcpServers": true
}
